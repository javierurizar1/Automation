[Unit]
Description=R4.3.3 Dedicated Chrome Fallback Browser
After=graphical-session.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@APP_ROOT@
Environment="DISPLAY=@DISPLAY@"
Environment="XAUTHORITY=@XAUTHORITY@"
Environment="XDG_RUNTIME_DIR=%t"
# Keep the fallback identity separate from the Brave source profile. The
# controller attaches to the committed data page, then navigates this visible
# profile to ChatGPT with its bounded post-attach navigation.
ExecStart=/usr/bin/google-chrome --remote-debugging-port=9334 --user-data-dir=%h/.config/R433-Chrome-Fallback --profile-directory=Default --no-first-run --no-default-browser-check data:text/html,%%3Ctitle%%3ER433%%20automation%%20bootstrap%%3C%%2Ftitle%%3E
Restart=on-failure
RestartSec=30s
TimeoutStartSec=45s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
